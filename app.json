{
  "expo": {
    "name": "Travelsofaka",
    "slug": "travel-sofaka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelsofaka.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D9488"
      },
      "package": "com.travelsofaka.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TripMate cần quyền camera để quét hóa đơn.",
          "photosPermission": "TripMate cần quyền ảnh để chọn hóa đơn cần quét.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "fee0d3ab-dcc0-4642-9a8c-6e49a10fbfde"
      }
    },
    "owner": "lhatu"
  }
}
