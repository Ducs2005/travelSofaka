# Firebase Web Config — Template
# Sao chép file này thành .env và điền giá trị thật
# File .env KHÔNG được commit lên git

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Gemini — sinh lịch trình du lịch ở Screen 05 (bắt buộc để dùng tính năng AI)
EXPO_PUBLIC_GEMINI_API_KEY=

# Cloudinary — CHỈ điền khi không dùng được Firebase Storage (project ở gói Spark)
# Để trống thì app tự dùng Firebase Storage đúng theo phân công SOC-03.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# OCR.space — tầng dự phòng cho Screen 07 khi ML Kit không khả dụng (không bắt buộc)
EXPO_PUBLIC_OCR_SPACE_API_KEY=
